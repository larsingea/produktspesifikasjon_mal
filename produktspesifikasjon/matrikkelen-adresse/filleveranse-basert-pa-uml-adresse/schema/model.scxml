     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>valgkretsnavn</sc:name>
       <sc:id>C11_1</sc:id>
