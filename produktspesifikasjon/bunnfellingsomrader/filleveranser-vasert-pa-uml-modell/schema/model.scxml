    <sc:Class>
     <sc:name>SedKornstorrelse</sc:name>
     <sc:id>C11</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>klassifisering av sedimentene basert på kornstørrelsessammensetning
Eksempel: &lt;b&gt;Slamholdig grus&lt;/b&gt;. Sand:silt+leir &lt;1:1, grus 30-80% betyr at sedimentet består av 30-80% grus, og i de øvrige 20-70% er innholdet av slam (silt+leire) større enn innholdet av sand.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>Uspesifisert</sc:name>
       <sc:id>C11_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kornstørrelse ikke angitt</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Tynt eller usammenhengende sedimentdekke over berggrunn</sc:name>
       <sc:id>C11_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Veksling mellom små sedimentbassenger, bart fjell og/eller bart fjell med tynt/usammenhengende sedimentdekke. Sedimenter har varierende kornstørrelse</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bart fjell</sc:name>
       <sc:id>C11_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Områder med bart fjell uten sedimentdekke</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Leire</sc:name>
       <sc:id>C11_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Leir:silt &gt;2:1 og leir+silt &gt;90%, sand &lt;10%, grus &lt;2%</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Organisk slam</sc:name>
       <sc:id>C11_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Leir:silt fra 1:2 til 2:1 og leir+silt &gt;90%, sand &lt;10%, grus &lt;2%. Høyt innhold av organisk materiale</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
