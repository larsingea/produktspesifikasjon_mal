   <sc:classes>
    <sc:Class>
     <sc:name>arealressursflate</sc:name>
     <sc:id>C1</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>featuretype</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>et sammenhengende areal som er tilordnet de samme egenskapsverdiene i henhold til et arealressursklassifikasjonssystem
-- Definition -- 
a continuous area which has been assigned the same attribute values in accordance with an area resource classification system</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>geometry</sc:name>
       <sc:id>C1_1</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>GM_Surface</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>id</sc:name>
       <sc:id>C1_2</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>identifikasjon.lokalid</sc:name>
       <sc:id>C1_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Lokal ID i datasettet - men skal være UUID</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>identifikasjon.navnerom</sc:name>
       <sc:id>C1_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navnerom til datasett. Skal være en oppslagsbar URI</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>4</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>informasjon</sc:name>
       <sc:id>C1_5</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>5</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
