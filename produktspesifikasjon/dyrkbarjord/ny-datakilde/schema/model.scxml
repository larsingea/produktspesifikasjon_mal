        <sc:DescriptorValue>avgrensing for en eller to arealressursflater
-- Definition -- 
delimitation for one or two area resource surfaces</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
