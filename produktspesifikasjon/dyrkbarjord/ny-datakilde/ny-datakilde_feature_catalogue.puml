@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dyrkbar jord - Ny datakilde - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class arealressursflate <<featureType>> {
    + id [1] : Integer
    + identifikasjon.lokalid [1] : CharacterString
    + identifikasjon.navnerom [1] : CharacterString
    + informasjon [1] : CharacterString
    + kopidata.kopidato [0..1] : Date
    + kopidata.områdeid [0..1] : Integer
    + kopidata.originaldatavert [0..1] : CharacterString
    + dyrkbarjord [1] : CharacterString
    + fulldyrka2008 [1] : CharacterString
    + myrtorv [1] : CharacterString
    + planeringsjord [1] : CharacterString
    + verneform [1] : CharacterString
    + årsversjon [1] : Integer
    + avgrensesavarealressursgrense_1 [0..1] : CharacterString
    + avgrensesavarealressursgrense_2 [0..1] : CharacterString
    + avgrensesavarealressursgrense_3 [0..1] : CharacterString

    ..Geometri..
    + geometry [1] : GM_Surface
  }

  class arealressursgrense <<featureType>> {
    + id [1] : Integer

    ..Geometri..
    + geometry [1] : GM_Curve
  }
}

@enduml
