     <sc:classes>
      <sc:Class>
       <sc:name>DyrkbarJord_Fellesegenskaper</sc:name>
       <sc:id>C1</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>abstrakt objekttype som bærer sentrale egenskaper som er anbefalt for bruk i produktspesifikasjoner.
Merknad: Disse egenskapene skal derfor ikke modelleres inn i fagområdemodeller.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:isAbstract>true</sc:isAbstract>
       <sc:properties>
        <sc:Property>
         <sc:name>identifikasjon</sc:name>
         <sc:id>C1_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
