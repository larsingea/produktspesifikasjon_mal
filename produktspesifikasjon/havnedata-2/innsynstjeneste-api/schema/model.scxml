       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Boolsk verdi som angir om havneanlegget er et ISPS Havneanlegg.</sc:DescriptorValue>
         </sc:descriptorValues>
