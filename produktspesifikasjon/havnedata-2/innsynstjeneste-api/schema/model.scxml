       <sc:id>C2_23</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato objektet er tilgjengelig fra. Brukes for objekter som kun er tilgjengelige deler av året eller i en sesong (sommer/vinter-halvåret). Dato oppgis som DD-MM. Årstall er ikke nødvendig.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>23</sc:sequenceNumber>
