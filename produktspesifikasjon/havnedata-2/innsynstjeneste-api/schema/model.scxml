     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Geografisk område som en havneadministrasjon eller en kommune har ansvaret for. Er ofte sammenfallende med kommunens sjøområde, med unntak av hoved- og biled.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
