       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Metode brukt for høyderegistrering av posisjon. 
Det er bare nødvending å angi en verdi for egenskapen dersom datafangstmetode for høyde avviker fra datafangstmetode for grunnriss.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
