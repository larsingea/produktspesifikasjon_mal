       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navn på havneanlegg. Navn bør stemme overens med SafeSeaNet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
