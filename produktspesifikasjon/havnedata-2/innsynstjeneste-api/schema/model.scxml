        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Marine Resource Name. Nummereringssystem for unik identifikasjon av maritime ressurser på global basis.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
