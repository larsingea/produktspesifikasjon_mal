         <sc:descriptorValues>
          <sc:DescriptorValue>Boolsk verdi som angir om havneanlegget er et ISPS Havneanlegg.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>13</sc:sequenceNumber>
