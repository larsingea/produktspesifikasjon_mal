      <sc:Property>
       <sc:name>GLN</sc:name>
       <sc:id>C8_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Global location number. Globalt nummersystem for identifikasjon av juridiske enheter og fysiske lokasjoner, forvaltet av GS1.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
