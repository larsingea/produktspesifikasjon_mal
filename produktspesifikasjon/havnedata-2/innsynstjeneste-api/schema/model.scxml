      </sc:Property>
      <sc:Property>
       <sc:name>MRN</sc:name>
       <sc:id>C8_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Marine Resource Name. Nummereringssystem for unik identifikasjon av maritime ressurser på global basis.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>11</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>UNLOCODE</sc:name>
       <sc:id>C8_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Lokaliseringskode fra UNLOCODE-systemet som identifiserer et havneområde. Koden består av 5 bokstaver: de to første bokstavene angir landskode, mens de tre siste identifiserer havnen. Eks: NOSVG (Stavanger). 
Se liste med lovlige kodeverdier her: https://service.unece.org/trade/locode/no.htm</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>12</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>ISPS</sc:name>
       <sc:id>C8_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Boolsk verdi som angir om havneanlegget er et ISPS Havneanlegg.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>13</sc:sequenceNumber>
       <sc:typeName>Boolean</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>havneanleggNavn</sc:name>
       <sc:id>C8_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navn på havneanlegg. Navn bør stemme overens med SafeSeaNet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
