      </sc:Property>
      <sc:Property>
       <sc:name>leveringsprosedyre</sc:name>
       <sc:id>C2_25</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Henvisning til leveringsprosedyre som gir informasjon om avfallsmottak og avfallshåndtering, for brukere av havnen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
