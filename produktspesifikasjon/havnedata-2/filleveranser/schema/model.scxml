         <sc:descriptorValues>
          <sc:DescriptorValue>Innretning for å løfte eller flytte tunge gjenstander, og hører til på kaien/havnen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C37</sc:SupertypeId>
       </sc:supertypes>
