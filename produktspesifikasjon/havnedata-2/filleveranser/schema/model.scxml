         <sc:descriptorValues>
          <sc:DescriptorValue>Abstrakt objekt som holder egenskaper for unik identifisering av objekt på kaien.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
