       <sc:id>C14</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Et basseng stort nok til at skip kan seile ut og inn. Bunnen ligger lavere enn havnivået og innløpet kan lukkes med porter. Vann kan pumpes ut, slik skip kan stå tørt, for vedlikehold og reperasjon.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
