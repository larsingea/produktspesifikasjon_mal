         <sc:id>C22_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>Polygon som viser geografisk utstrekning.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
