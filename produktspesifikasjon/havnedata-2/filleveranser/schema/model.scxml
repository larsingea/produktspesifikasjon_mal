            <sc:DescriptorValue>Felt for å angi hvem som forvalter eller administrerer havneområdet.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>område</sc:name>
         <sc:id>C21_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>Polygon som viser geografisk utstrekning</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
