         <sc:name>krantype</sc:name>
         <sc:id>C1_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>Krantype.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
