         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>Kodeliste for å spesifisere energikilden til kranen.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
