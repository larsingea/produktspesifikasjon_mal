         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>Unikt løpenummer for identifisering av det enkelte objekt på kaien, i form av nummer/tekst.</sc:DescriptorValue>
           </sc:descriptorValues>
