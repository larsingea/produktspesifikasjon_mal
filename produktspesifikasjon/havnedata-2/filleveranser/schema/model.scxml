      <sc:Property>
       <sc:name>kontaktId</sc:name>
       <sc:id>C44_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Id-nummer eller annen beskrivelse som spesifiserer hvilken type kontakt.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>4</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>sikringstørrelse</sc:name>
       <sc:id>C44_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Strømstyrke, oppgis i ampere, SI-enheten for elektrisk strøm. Strømstyrke er lik ladning som passerer et tverrsnitt av en leder pr. sekund.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>5</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>spenning</sc:name>
       <sc:id>C44_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Volt. Elektrisk spenning.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>6</sc:sequenceNumber>
       <sc:typeId>C73</sc:typeId>
       <sc:typeName>Spenning</sc:typeName>
